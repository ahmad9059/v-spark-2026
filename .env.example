# Copy to .env and fill in. Never commit .env.

# --- Supabase (auth, database, storage) ---------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Server only. Needed for the reminder cron job, which reads every user's posts.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Google Gemini (caption generation) ---------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# --- Google OAuth (sign in + Drive sync) --------------------------------
# Same OAuth client you add to Supabase > Auth > Providers > Google.
# Drive API must be enabled. Used to refresh Drive access tokens.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google Maps (location tagging + map preview) -----------------------
# Server key: Places API (New) enabled. Embed key: Maps Embed API enabled,
# restricted to your site's domain. They can be the same key.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=""

# --- Email (SMTP) --------------------------------------------------------
# Gmail: turn on 2-step verification, then create an App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Spark Scheduler <you@gmail.com>"

# --- Cron ----------------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron/reminders.
CRON_SECRET=""
